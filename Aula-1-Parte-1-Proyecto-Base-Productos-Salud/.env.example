# Copia este archivo a .env y rellena los valores reales.
# El .env NUNCA se sube al repo (está en el .gitignore de la raíz).

# --- OpenAI (LLM + embeddings) ---
OPENAI_API_KEY=sk-proj-...

# --- Qdrant (servidor propio) ---
# Sin puerto si está detrás de un reverse proxy HTTPS (EasyPanel, Traefik, nginx).
# Con puerto si es un Qdrant en crudo, p. ej. http://localhost:6333
QDRANT_URL=https://qdrant.mi-servidor.host
QDRANT_API_KEY=

# --- Colecciones (convención multi-tenant: prefijo tenant_id_) ---
# Una por estrategia de splitting: los chunks no son comparables entre sí.
QDRANT_COLLECTION_SENTENCE=tenant_id_productos_salud_sentence
QDRANT_COLLECTION_SEMANTIC=tenant_id_productos_salud_semantic
