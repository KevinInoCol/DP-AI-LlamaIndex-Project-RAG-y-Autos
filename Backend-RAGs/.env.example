# Copia este archivo a .env y coloca tu clave real de OpenAI.
# Solo es necesaria para los splitters SEMÁNTICOS (Con API Key).
OPENAI_API_KEY=sk-...

# Modelo de embeddings usado por los splitters semánticos
OPENAI_EMBED_MODEL=text-embedding-3-small

# Necesaria SOLO para el Document Loader "LlamaParse" (el mejor).
# Consíguela gratis en https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=llx-...
